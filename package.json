{
  "name": "nova-coin-bot",
  "version": "1.0.0",
  "description": "Discord bot for Nova Coin virtual currency system with shops, daily rewards, activity tracking, and leaderboards",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development npm run build && npm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "pg": "^8.20.0",
    "express": "^5",
    "cors": "^2",
    "cookie-parser": "^1.4.7",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^25.3.3",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "currency",
    "coins",
    "game",
    "economy"
  ],
  "author": "",
  "license": "MIT"
}
